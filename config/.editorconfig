# Unified EditorConfig rules
# This file contains additional rules specific to the config/ directory.
# The root .editorconfig applies to the entire repository.

# StyleCop configuration files
[stylecop.json]
indent_size = 2

# NuGet configuration
[nuget.config]
indent_size = 2

# TypeScript ESLint shared config
[.eslintrc.shared.cjs]
indent_size = 2