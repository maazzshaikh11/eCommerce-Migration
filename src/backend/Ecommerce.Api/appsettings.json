{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSigningKey": "bXlzZWNyZXRrZXltdXN0YmVleGFjdGx5MzJieXRlc2xvbmc=",
  "ConnectionStrings": {
    "LegacyEcommerceDb": "Server=(localdb)\\MSSQLLocalDB;Database=LegacyEcommerceDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "ReverseProxy": {
    "Routes": {
      "login": {
        "ClusterId": "spaCluster",
        "Priority": 3,
        "Match": { "Path": "/login/{**catch-all}" }
      },
      "register": {
        "ClusterId": "spaCluster",
        "Priority": 3,
        "Match": { "Path": "/register/{**catch-all}" }
      },
      "orders": {
        "ClusterId": "spaCluster",
        "Priority": 3,
        "Match": { "Path": "/orders/{**catch-all}" }
      },
      "home": {
        "ClusterId": "spaCluster",
        "Priority": 3,
        "Match": { "Path": "/" }
      },
      "products": {
        "ClusterId": "spaCluster",
        "Priority": 3,
        "Match": { "Path": "/products/{**catch-all}" }
      },
      "product": {
        "ClusterId": "spaCluster",
        "Priority": 3,
        "Match": { "Path": "/product/{**catch-all}" }
      },
      "checkout": {
        "ClusterId": "spaCluster",
        "Priority": 3,
        "Match": { "Path": "/checkout/{**catch-all}" }
      },
      "cart": {
        "ClusterId": "spaCluster",
        "Priority": 3,
        "Match": { "Path": "/cart/{**catch-all}" }
      },
      "app": {
        "ClusterId": "spaCluster",
        "Priority": 2,
        "Match": { "Path": "/app/{**catch-all}" }
      },
      "spa-fallback": {
        "ClusterId": "spaCluster",
        "Priority": 1,
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "spaCluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5002" }
        }
      }
    }
  }
}